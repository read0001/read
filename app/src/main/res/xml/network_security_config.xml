<?xml version="1.0" encoding="utf-8"?>
<!-- Book sources are community-maintained and many are plain http, so cleartext has to be allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
